# Copy to .env.community (same folder as community-api.py) and fill in.
# --- required ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-(publishable)-KEY
# --- hosting ---
# header  = the reverse proxy sends an x-visitor-id header for each browser (Perplexity hosting)
# cookie  = the service issues its own first-party visitor cookie (most other hosts)
HBA_VISITOR_MODE=cookie
# Origin(s) of the sign-in page if it is served from a different host than the API (comma separated). Leave empty when same origin.
HBA_ALLOWED_ORIGINS=
# Contact address embedded in Web Push messages to administrators
HBA_PUSH_SUBJECT=mailto:admin@example.org
# --- optional ---
# Enables "Ask our documents" (AI answers over the archive). Leave unset to turn the feature off.
OPENAI_API_KEY=
# Model used with OPENAI_API_KEY, e.g. the current OpenAI model you want for drafting. Required when the key is a
# direct OpenAI key; Perplexity hosting uses its own default.
OPENAI_MODEL=
