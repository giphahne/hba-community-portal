# Copy to .env.community (same folder as community-api.py) for local development, or set these as environment
# variables in your host's dashboard. Never commit real values.
# --- required ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-(publishable)-KEY
# Secrets: generate with `python tools/generate-secrets.py` (or `--from-dir` to reuse an old community-private-data
# folder). Keep them stable. Changing HBA_SESSION_KEY signs everyone out and stops existing payer keys from matching;
# changing HBA_VAPID_PRIVATE_KEY unsubscribes administrators' devices from alerts.
# Left empty, local development generates them into community-private-data/ instead.
HBA_SESSION_KEY=
HBA_VAPID_PRIVATE_KEY=
# Public address of the portal, used for links in drafted e-mails and notices
HBA_PUBLIC_URL=https://portal.example.org
# Contact address embedded in Web Push messages to administrators
HBA_PUSH_SUBJECT=mailto:admin@example.org
# --- optional ---
# Enables "Ask our documents" and AI document intake. Leave unset to turn the features off.
OPENAI_API_KEY=
# OpenAI model used for those features (required with a direct OpenAI key)
OPENAI_MODEL=
